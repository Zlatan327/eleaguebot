# ==========================================
# eLeagueBot Configuration
# ==========================================

# Database Path (default: ./data/eleague.db)
DB_PATH=./data/eleague.db

# WhatsApp Session Storage Directory
SESSION_DIR=./.wwebjs_auth

# Match Rules
DEFAULT_DEADLINE_DAYS=3
DEFAULT_POINTS_WIN=3
DEFAULT_POINTS_DRAW=1
DEFAULT_POINTS_LOSS=0

# Initial Admin Phone Number (e.g. 1234567890)
# Anyone with this phone number will be automatically registered as Super Admin on boot
INITIAL_ADMIN_PHONE=

# Optional: Lock bot commands to a specific WhatsApp Group ID
# Run '!setgroup' inside the WhatsApp group to lock automatically
LEAGUE_GROUP_ID=

# Submission Policy: 'players_or_admin' (default) or 'admin_only'
SUBMISSION_POLICY=players_or_admin

# Optional: Google AI Studio API Key for eFootball Screenshot OCR Parsing
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.5-flash
